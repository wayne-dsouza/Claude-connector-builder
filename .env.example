# Your Lemlist API key. Generate one at https://app.lemlist.com/settings/integrations
LEMLIST_API_KEY=your_lemlist_api_key_here

# Transport mode: "stdio" (default, for Claude Desktop / Claude Code) or "http" (remote custom connector)
# MODE=stdio

# HTTP mode only: port to listen on (default 3000)
# PORT=3000

# HTTP mode only: if set, incoming requests must send this bearer token to connect.
# Leave unset to allow the per-request Lemlist API key (via Authorization/X-Lemlist-Api-Key header)
# or fall back to LEMLIST_API_KEY above.
# MCP_AUTH_TOKEN=
