{
  "name": "lemlist-mcp-connector",
  "version": "1.0.0",
  "description": "Custom Claude connector (MCP server) for the Lemlist outreach API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lemlist-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MODE=http node dist/index.js",
    "dev": "tsc --watch",
    "smoke": "node scripts/smoke-test.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
